# Supabase (public anon key - safe for frontend, but use env vars for easy rotation)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog (session replay, heatmaps, product analytics)
# A default project key is baked into src/app/posthog.ts so it works out of the box.
# Override here to target a different project. Set VITE_POSTHOG_HOST to
# https://eu.i.posthog.com if your project is in the EU region (default: US).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
