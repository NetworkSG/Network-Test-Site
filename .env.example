# Supabase (public anon key - safe for frontend, but use env vars for easy rotation)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_ANON_KEY=your-anon-key

# Microsoft Clarity (session recording + heatmaps)
# Project ID from clarity.microsoft.com → Settings → Setup. Leave blank to disable.
VITE_CLARITY_ID=
